# VidSage Environment Variables
# Copy this file to backend/.env for local development and replace every placeholder.
# Never commit backend/.env.

# Core API keys
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Whisper / speech-to-text
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# LLM / cleaning
CLEANING_MODEL=llama-3.1-8b-instant

# Optional local model paths
LOCAL_LLM_MODEL_PATH=../models/ggml-alpaca-7b-q4.bin
LOCAL_LLM_THREADS=4
PREFER_LOCAL_LLM=false

# Ollama
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3
OLLAMA_TIMEOUT=120

# OpenRouter
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_TIMEOUT=120

# Authentication
AUTH_ENABLED=true
AUTH_USERNAME=your_admin_email@example.com
AUTH_PASSWORD=change-me
AUTH_PASSWORD_HASH=
AUTH_SECRET_KEY=replace_with_a_long_random_secret
AUTH_ISSUER=vidsage-api
AUTH_AUDIENCE=vidsage-client
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ACCESS_COOKIE_NAME=vidsage_access
AUTH_REFRESH_COOKIE_NAME=vidsage_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_LEEWAY_SECONDS=30
AUTH_MAX_LOGIN_ATTEMPTS=6
AUTH_LOGIN_WINDOW_SECONDS=300

# Runtime / deployment
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
DOWNLOAD_DIR=backend/app/downloads
UPLOAD_DIR=backend/app/uploads
CHROMA_DB_DIR=backend/chroma_db
