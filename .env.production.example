# =============================================================
# VidSage — Production Environment Template
# Copy to backend/.env and fill in ALL values
# =============================================================

# ── Runtime ──────────────────────────────────────
ENVIRONMENT=production

# ── Redis (internal Docker network) ──────────────
REDIS_URL=redis://redis:6379/0

# ── Frontend URL (for CORS) ─────────────────────
FRONTEND_URL=http://your-domain.com

# ── API Keys ─────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Whisper / Speech-to-Text ────────────────────
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=auto

# ── LLM / Cleaning ─────────────────────────────
CLEANING_MODEL=llama-3.1-8b-instant

# ── OpenRouter ──────────────────────────────────
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_TIMEOUT=120

# ── YouTube Anti-Blocking ───────────────────────
# Comma-separated proxy URLs. Types supported:
#   socks5://user:pass@host:port
#   http://user:pass@host:port
#   https://user:pass@host:port
# Leave empty for direct (no proxy) — will hit YouTube limits fast
PROXY_LIST=
# Path to YouTube cookies.txt (export from browser extension)
# This helps with age-restricted or private videos
YT_COOKIE_FILE=
# Minimum seconds between YouTube requests (higher = safer)
YT_REQUEST_INTERVAL=3.0

# ── Authentication (PRODUCTION — MUST CHANGE) ───
AUTH_ENABLED=true
AUTH_USERNAME=admin@yourdomain.com
# Do NOT set AUTH_PASSWORD in production — use HASH only
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=        # ← generate with: python generate_secrets.py
AUTH_SECRET_KEY=           # ← generate with: python generate_secrets.py
AUTH_ISSUER=vidsage-api
AUTH_AUDIENCE=vidsage-client
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ACCESS_COOKIE_NAME=vidsage_access
AUTH_REFRESH_COOKIE_NAME=vidsage_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_LEEWAY_SECONDS=30
AUTH_MAX_LOGIN_ATTEMPTS=6
AUTH_LOGIN_WINDOW_SECONDS=300
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── Google OAuth (optional) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://your-domain.com/api/auth/google/callback
GOOGLE_OAUTH_STATE_COOKIE_NAME=vidsage_google_oauth_state
GOOGLE_OAUTH_NEXT_COOKIE_NAME=vidsage_google_oauth_next

# ── File Paths (defaults are fine inside Docker) ─
DOWNLOAD_DIR=/app/app/downloads
UPLOAD_DIR=/app/app/uploads
CHROMA_DB_DIR=/app/chroma_db